
@{
    ViewData["Title"] = "FoodLoop - Save Food, Share Hope";
}

<style>
    .hero {
        background: linear-gradient(135deg, #075638, #159957);
        color: white;
        border-radius: 24px;
        padding: 55px 35px;
        margin: 25px 0;
        overflow: hidden;
    }

    .hero h1 {
        font-size: clamp(2.2rem, 5vw, 3.6rem);
        font-weight: 800;
        line-height: 1.15;
    }

    .hero p {
        font-size: 17px;
        line-height: 1.8;
    }

    .hero-image {
        font-size: 115px;
        text-align: center;
        padding: 15px;
    }

    .section-title {
        color: #16452f;
        font-weight: 800;
    }

    .feature-card {
        background: white;
        border: 1px solid #e2eee6;
        border-radius: 18px;
        padding: 28px 22px;
        height: 100%;
        transition: .25s;
    }

    .feature-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 28px #07563815;
    }

    .feature-icon {
        width: 65px;
        height: 65px;
        background: #e7f7ed;
        border-radius: 17px;
        display: grid;
        place-items: center;
        font-size: 32px;
        margin-bottom: 18px;
    }

    .feature-card h4 {
        font-weight: 750;
        color: #16452f;
    }

    .impact-section {
        background: #eff9f2;
        border-radius: 22px;
        padding: 35px 20px;
    }

    .impact-number {
        color: #07824b;
        font-size: 30px;
        font-weight: 800;
    }

    .cta-section {
        background: linear-gradient(120deg, #075638, #159957);
        color: white;
        padding: 38px 25px;
        border-radius: 22px;
    }

    .cta-section h2 {
        font-weight: 800;
    }

    .home-btn {
        border-radius: 10px;
        padding: 12px 22px;
        font-weight: 700;
    }
</style>

<div class="container mb-5">

    <!-- Hero Section -->
    <section class="hero">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-light text-success mb-3 p-2">
                    🌱 FOODLOOP COMMUNITY
                </span>

                <h1>
                    Save Food.<br />
                    Share Hope.
                </h1>

                <p class="mt-3 mb-4">
                    Good food deserves a second chance.
                    Connect surplus food with people who need it
                    and help build a world with less food waste.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Foods"
                       asp-action="Create"
                       class="btn btn-light text-success home-btn">
                        🍱 Donate Food
                    </a>

                    <a asp-controller="Foods"
                       asp-action="Index"
                       class="btn btn-outline-light home-btn">
                        Explore Donations →
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-image">🥗 🌍</div>
            </div>
        </div>
    </section>

    <!-- Welcome Section -->
    <section class="text-center py-4">
        <p class="text-success fw-bold mb-2">
            WHAT IS FOODLOOP?
        </p>

        <h2 class="section-title">
            Small Actions, Big Impact
        </h2>

        <p class="text-muted mx-auto mt-3"
           style="max-width:700px;">
            FoodLoop is a food donation platform that helps
            restaurants, hotels, event organizers and communities
            share surplus food instead of wasting it.
        </p>
    </section>

    <!-- Features -->
    <section class="row g-4 mt-2 mb-5">

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">🍱</div>

                <h4>Donate Surplus Food</h4>

                <p class="text-muted mb-3">
                    List extra food with its name, quantity
                    and location to help someone in need.
                </p>

                <a asp-controller="Foods"
                   asp-action="Create"
                   class="btn btn-outline-success">
                    Donate Now →
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">🤝</div>

                <h4>Connect Communities</h4>

                <p class="text-muted mb-3">
                    Make it easier for people and organizations
                    to discover available food donations.
                </p>

                <a asp-controller="Foods"
                   asp-action="Index"
                   class="btn btn-outline-success">
                    Explore Food →
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">🌍</div>

                <h4>Reduce Food Waste</h4>

                <p class="text-muted mb-3">
                    Give surplus food a useful purpose and
                    support a more sustainable community.
                </p>

                <a asp-controller="Foods"
                   asp-action="Index"
                   class="btn btn-outline-success">
                    Get Involved →
                </a>
            </div>
        </div>

    </section>

    <!-- Impact Section -->
    <section class="impact-section text-center mb-5">
        <p class="text-success fw-bold mb-2">
            OUR MISSION
        </p>

        <h2 class="section-title mb-4">
            Every Meal Matters
        </h2>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="impact-number">♻️</div>
                <h5 class="fw-bold mt-2">Less Waste</h5>
                <p class="text-muted mb-0">
                    Encourage responsible food sharing.
                </p>
            </div>

            <div class="col-md-4">
                <div class="impact-number">❤️</div>
                <h5 class="fw-bold mt-2">More Care</h5>
                <p class="text-muted mb-0">
                    Support people and local communities.
                </p>
            </div>

            <div class="col-md-4">
                <div class="impact-number">🌱</div>
                <h5 class="fw-bold mt-2">A Greener Future</h5>
                <p class="text-muted mb-0">
                    Build sustainable habits together.
                </p>
            </div>
        </div>
    </section>

    <!-- Call To Action -->
    <section class="cta-section text-center">
        <h2>Be a Food Hero Today!</h2>

        <p class="mt-3 mb-4">
            Have extra food? Share it with someone who needs it.
            One small donation can make a meaningful difference.
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a asp-controller="Foods"
               asp-action="Create"
               class="btn btn-light text-success home-btn">
                + Start a Donation
            </a>

            <a asp-controller="Foods"
               asp-action="Index"
               class="btn btn-outline-light home-btn">
                View Food Listings
            </a>
        </div>
    </section>

</div>
