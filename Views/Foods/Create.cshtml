
@model FoodLoop.Models.Food

@{
    ViewData["Title"] = "Donate Food";
}

<div class="container mt-5 mb-5" style="max-width:650px">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white p-3">
            <h3 class="mb-0">🍱 Donate Surplus Food</h3>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="FoodName" class="form-label">
                        Food Name
                    </label>
                    <input asp-for="FoodName" class="form-control"
                           placeholder="e.g. Vegetable Pulao" />
                    <span asp-validation-for="FoodName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">
                        Quantity (Meals)
                    </label>
                    <input asp-for="Quantity" type="number" min="1"
                           class="form-control" placeholder="e.g. 20" />
                    <span asp-validation-for="Quantity"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label">
                        Pickup Location
                    </label>
                    <input asp-for="Location" class="form-control"
                           placeholder="Enter pickup location" />
                    <span asp-validation-for="Location"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
    <label asp-for="Status" class="form-label">Food Status</label>

    <select asp-for="Status" class="form-select">
        <option value="Available">Available</option>
        <option value="Reserved">Reserved</option>
        <option value="Donated">Donated</option>
    </select>

    <span asp-validation-for="Status" class="text-danger"></span>
</div>

                <button type="submit" class="btn btn-success w-100">
                    Submit Donation
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100 mt-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
