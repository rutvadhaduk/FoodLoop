
@model FoodLoop.Models.Food

@{
    ViewData["Title"] = "Delete Donation";
}

<div class="container mt-5" style="max-width:600px">
    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">
            <h2 class="text-danger">Delete Donation?</h2>
            <p>Are you sure you want to delete this food donation?</p>

            <dl class="row">
                <dt class="col-sm-4">Food Name</dt>
                <dd class="col-sm-8">@Model.FoodName</dd>

                <dt class="col-sm-4">Quantity</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>

                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@Model.Location</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
