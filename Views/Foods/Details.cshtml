```cshtml
@model FoodLoop.Models.Food

@{
    ViewData["Title"] = "Food Details";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto"
         style="max-width:650px;border-radius:20px;overflow:hidden;">

        <div class="p-4 text-white"
             style="background:linear-gradient(120deg,#075638,#159957);">
            <h2 class="fw-bold mb-2">🍱 Food Details</h2>
            <p class="mb-0">Complete information about this donation</p>
        </div>

        <div class="card-body p-4">
            <div class="text-center mb-4">
                <div style="font-size:65px;">🥗</div>
                <h3 class="fw-bold">@Model.FoodName</h3>
            </div>

            <div class="border rounded-3 p-3 mb-3">
                <small class="text-muted">Food Name</small>
                <div class="fw-bold">@Model.FoodName</div>
            </div>

            <div class="border rounded-3 p-3 mb-3">
                <small class="text-muted">Quantity</small>
                <div class="fw-bold">🍽️ @Model.Quantity meals</div>
            </div>

            <div class="border rounded-3 p-3 mb-3">
                <small class="text-muted">Location</small>
                <div class="fw-bold">📍 @Model.Location</div>
            </div>

            <div class="border rounded-3 p-3 mb-3">
                <small class="text-muted">Status</small>
                <div class="fw-bold">@Model.Status</div>
            </div>

            <div class="border rounded-3 p-3 mb-4">
                <small class="text-muted">Donation Date</small>
                <div class="fw-bold">
                    @Model.DonationDate.ToString("dd MMM yyyy, hh:mm tt")
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">
                    ✏️ Edit Donation
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    ← Back to Donations
                </a>
            </div>
        </div>
    </div>
</div>
